+
+  read_grid <- function(path) {
+    r <- terra::rast(path)
+    if (terra::nlyr(r) < 1L || terra::ncell(r) < 4L) stop("NOAA returned an empty raster.")
+    out <- terra::as.data.frame(r[[1]], xy = TRUE, na.rm = FALSE)
+    if (ncol(out) < 3L) stop("NOAA returned an unreadable raster.")
+    names(out)[1:3] <- c("lon", "lat", "elevation_m")
+    out <- out[, c("lon", "lat", "elevation_m"), drop = FALSE]
+    out$lon <- as.numeric(out$lon)
+    out$lat <- as.numeric(out$lat)
+    out$elevation_m <- as.numeric(out$elevation_m)
+    out
+  }
 
   for (res in chain) {
